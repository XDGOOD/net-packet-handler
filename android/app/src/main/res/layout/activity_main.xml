<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D10">

    <!-- Native Dynamic Wave Background Circles -->
    <com.aegs.titan.WaveCirclesBackgroundView
        android:id="@+id/wave_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Foreground UI -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Header -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AEGS TITAN"
                        android:textColor="#FFFBEB"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="v6.2 • RFC 9000 QUIC Stealth"
                        android:textColor="#F59E0B"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_open_add_source"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:text="+"
                        android:textColor="#FFFBEB"
                        android:textSize="18sp"
                        android:backgroundTint="#241E1C24"
                        android:layout_marginEnd="8dp" />

                    <Button
                        android:id="@+id/btn_open_settings"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:text="⚙"
                        android:textColor="#FFFBEB"
                        android:textSize="16sp"
                        android:backgroundTint="#241E1C24" />
                </LinearLayout>
            </RelativeLayout>

            <!-- Update Banner -->
            <LinearLayout
                android:id="@+id/banner_update"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#2AF59E0B"
                android:padding="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="✓ AEGS Titan v6.2 актуален"
                    android:textColor="#FFFBEB"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_close_banner"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✕"
                    android:textColor="#A8A29E"
                    android:padding="4dp" />
            </LinearLayout>

            <!-- Status Pill -->
            <TextView
                android:id="@+id/tv_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="● Отключено"
                android:textColor="#F87171"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="#14FFFFFF"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_marginBottom="14dp" />

            <!-- Big Connect Button (Where wave line forms!) -->
            <LinearLayout
                android:id="@+id/btn_connect_circle"
                android:layout_width="148dp"
                android:layout_height="148dp"
                android:layout_gravity="center_horizontal"
                android:background="#E617161C"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="20dp">

                <TextView
                    android:id="@+id/tv_conn_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ПОДКЛЮЧИТЬ"
                    android:textColor="#FFFBEB"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_conn_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Готов?"
                    android:textColor="#F59E0B"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Shortcuts Row (Protocol & Apps) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:id="@+id/btn_shortcut_settings"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="#E617161C"
                    android:padding="12dp"
                    android:layout_marginEnd="6dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/lbl_protocol"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="QUIC v6"
                        android:textColor="#FFFBEB"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AEGS DoH"
                        android:textColor="#A8A29E"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btn_shortcut_apps"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="#E617161C"
                    android:padding="12dp"
                    android:layout_marginStart="6dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Приложения"
                        android:textColor="#FFFBEB"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/lbl_apps_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4 через VPN"
                        android:textColor="#A8A29E"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Telemetry Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#E617161C"
                android:padding="14dp"
                android:orientation="vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ТЕЛЕМЕТРИЯ КАНАЛА"
                    android:textColor="#A8A29E"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tv_ping"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Пинг: -- мс"
                    android:textColor="#F59E0B"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_speed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Скорость: 0.0 Мбит/с"
                    android:textColor="#FFFBEB"
                    android:textSize="13sp"
                    android:layout_marginTop="3dp" />
            </LinearLayout>

            <!-- Active Server Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#E617161C"
                android:padding="14dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="АКТИВНЫЙ УЗЕЛ"
                    android:textColor="#A8A29E"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_active_server"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AEGS Cloud — Нидерланды"
                    android:textColor="#FFFBEB"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="IP: 185.196.8.10:50001 (QUIC UDP)"
                    android:textColor="#A8A29E"
                    android:textSize="11sp"
                    android:layout_marginTop="1dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</FrameLayout>
